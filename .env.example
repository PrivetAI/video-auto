# Whisper-TikTok Service URL
WHISPER_TIKTOK_URL=http://whisper-tiktok:8001

# Image Generation (Replicate) - optional
# If not set, placeholder images will be used
REPLICATE_API_TOKEN=
IMAGE_MODEL=flux-schnell
IMAGE_STYLE_PRESET=cinematic

# Logging
LOG_LEVEL=INFO

# Directories
CACHE_DIR=cache
OUTPUT_DIR=output